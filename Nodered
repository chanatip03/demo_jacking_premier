        "z": "7346079f9645c103",
        "name": "function 7",
        "func": "// 1. รับข้อความดิบเข้ามา\nvar rawText = msg.payload;\n\n// 2. หั่นข้อความออกเป็นบรรทัดๆ ด้วย <br>\nvar lines = rawText.split(\"<br>\");\n\nvar myValue = null; // ตัวแปรสำหรับเก็บผลลัพธ์\n\n// 3. วนลูปเช็คทีละบรรทัด ตั้งแต่บรรทัดแรกยันบรรทัดสุดท้าย\nfor (var i = 0; i < lines.length; i++) {\n\n    var currentLine = lines[i].trim(); // ตัดช่องว่างขอบๆ ทิ้งก่อน\n\n    // 4. เช็คว่าบรรทัดนี้มีคำว่า \"Gauge40\" หรือไม่?\n    if (currentLine.includes(\"gate2\")) {\n\n        // เจอแล้ว! เช่นบรรทัดนี้คือ \"Gauge40 50\"\n        // เราจะลบคำว่า \"Gauge40\" ทิ้งไป ให้เหลือแต่เลข\n        myValue = currentLine.replace(\"gate2\", \"\").trim();\n\n        // (เทคนิคเสริม) ถ้ามีหลายตัว โค้ดนี้จะจำตัว \"ล่าสุด\" (ตัวล่างสุด) ที่เจอครับ\n    }\n}\n\n// 5. ส่งค่าที่ได้ออกไป (จะได้ค่า \"50\")\nmsg.payload = myValue;\n\nreturn msg;\n",
